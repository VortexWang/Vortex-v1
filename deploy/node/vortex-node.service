# VORTEX 节点端（Agent + 嵌入的 Engine，GEN-002；AGT-T17）。由 deploy/node/install.sh 安装到 /etc/systemd/system。
[Unit]
Description=VORTEX node (Agent + Engine)
Documentation=https://github.com/VortexWang/Vortex-v1/tree/main/deploy
After=network-online.target
Wants=network-online.target
# 升级后的崩溃循环由 upgrade-guard 处理（见下），systemd 不应因启动过快而放弃重启
StartLimitIntervalSec=0

[Service]
Type=simple
User=vortex
Group=vortex
# 升级回退的保护（AGT-008）：每次启动前由上一版本（.prev）计数新版本的启动次数，连续 3 次未健康即恢复上一版本。
# 新版本即使在运行时初始化阶段就崩溃也能回退。没有 .prev 或没有升级在进行时什么也不做；“-”：失败不阻止启动。
ExecStartPre=-/bin/sh -c 'p=/opt/vortex/node/vortex-node.prev; if [ -x "$p" ]; then exec "$p" upgrade-guard -config /etc/vortex/node.json; fi'
ExecStart=/opt/vortex/node/vortex-node run -config /etc/vortex/node.json
# 升级与回退以退出码 75 结束，由这里重启；其他异常退出同样重启
Restart=always
RestartSec=1
# 停止时 Engine 关闭监听与会话，Agent 落盘最后一批计量
TimeoutStopSec=30
KillSignal=SIGTERM
LimitNOFILE=1048576

# 运行身份与权限：只保留绑定低端口的能力（入口监听可能使用 80/443 等）
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
# 文件系统：只读，除数据目录（证书、本地数据库、升级工作区）与程序目录（升级时原子替换）
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
StateDirectory=vortex
StateDirectoryMode=0700
RuntimeDirectory=vortex
RuntimeDirectoryMode=0755
ReadWritePaths=/opt/vortex/node
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
